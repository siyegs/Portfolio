# Interview Me chat - Groq (free) API key. Get one at https://console.groq.com
# Used server-side only (Vite dev middleware + Cloudflare Worker). Never shipped
# to the browser. Copy this file to .env and paste your key.
GROQ_API_KEY=your-groq-key-here

# Optional: in production, set this to your deployed Cloudflare Worker URL so the
# frontend calls it instead of the local /api/chat dev endpoint.
# VITE_CHAT_ENDPOINT=https://your-worker.workers.dev
