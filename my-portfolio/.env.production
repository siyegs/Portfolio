# Production build settings. Safe to commit - this is a public endpoint, not a
# secret. The Groq key lives on the Worker (`bun run chat:secret`), never here.
#
# Without this, prod builds fall back to /api/chat, which only exists as Vite dev
# middleware - Firebase Hosting answers it with index.html and the chat silently
# does nothing.
VITE_CHAT_ENDPOINT=https://interview-chat.iyegeresk.workers.dev
